-- Laptop panel; hypr-scale changes the scale at runtime
hl.monitor({ output = "eDP-1", mode = "preferred", position = "auto", scale = 1 })


---------------------
---- MY PROGRAMS ----
---------------------

local terminal = "ghostty"
local menu     = "rofi -show drun -show-icons"


-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'")
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    hl.exec_cmd("systemctl --user restart xdg-desktop-portal.service")
    hl.exec_cmd("/usr/lib/polkit-kde-authentication-agent-1")
    hl.exec_cmd("waybar")
    hl.exec_cmd("~/.config/waybar/scripts/notifications.sh --listen")
    hl.exec_cmd("discord --start-minimized")
    hl.exec_cmd("1password --silent")
    hl.exec_cmd("opendeck")
    hl.exec_cmd("monitor-check")
{{- if $nvidia }}
    hl.exec_cmd("flatpak-nvidia-sync")
{{- end }}
    hl.exec_cmd("xrandr --output DP-6 --primary")
    hl.exec_cmd("wl-paste --type text --watch cliphist store")
    hl.exec_cmd("wl-paste --type image --watch cliphist store")
    -- hyprwhspr speech-to-text daemon (no uwsm, so graphical-session.target never activates)
    hl.exec_cmd("systemctl --user start hyprwhspr")
end)


-------------------------------
---- ENVIRONMENT VARIABLES ----
-------------------------------

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")

-- Electron/Chromium apps - use native Wayland with explicit sync
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")

-- Dark mode preference
hl.env("GTK_THEME", "Adwaita:dark")
hl.env("QT_QPA_PLATFORMTHEME", "qt5ct")
{{- if $nvidia }}

-- NVIDIA GPU - required for Hyprland to launch
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
-- egl backend: the newer `direct` backend crashes Chrome's GPU process during
-- VA-API video decode (browser "freaks out" on videos). egl is slower but stable.
hl.env("NVD_BACKEND", "egl")
-- Hide the AMD iGPU's Vulkan ICD so apps don't default to it.
-- Zen 5 desktop CPUs (e.g. 9850X3D) ship a 2-CU RDNA2 iGPU that the Vulkan
-- loader enumerates as device 0 — Chrome/games render on it instead of the
-- dGPU, causing stutter and low FPS. No-op on pure-NVIDIA systems.
hl.env("VK_LOADER_DRIVERS_DISABLE", "*radeon*")
{{- end }}


