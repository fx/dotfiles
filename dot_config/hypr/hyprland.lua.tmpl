---------------------
---- KEYBINDINGS ----
---------------------

local mainMod = "ALT"

local function key(k) return mainMod .. " + " .. k end

-- Core
hl.bind(key("Return"), hl.dsp.exec_cmd(terminal))
hl.bind(key("Q"),      hl.dsp.window.close())
hl.bind(key("L"),      hl.dsp.exec_cmd("hyprlock"))
hl.bind(key("E"),      hl.dsp.exec_cmd("$HOME/.local/share/mise/shims/tx rc pick"))
hl.bind(key("V"),      hl.dsp.window.float({ action = "toggle" }))
hl.bind(key("D"),      hl.dsp.exec_cmd(menu))
hl.bind(key("P"),      hl.dsp.window.pseudo())
hl.bind(key("T"),      hl.dsp.layout("togglesplit"))
hl.bind(key("F"),      hl.dsp.window.fullscreen())

for _, dir in ipairs({ "left", "right", "up", "down" }) do
    -- Move focus with mainMod + arrow keys
    hl.bind(key(dir),             hl.dsp.focus({ direction = dir }))
    -- Move windows with mainMod + SHIFT + arrow keys
    hl.bind(key("SHIFT + " .. dir), hl.dsp.window.move({ direction = dir }))
end

-- Move window to other monitor
hl.bind(key("comma"),  hl.dsp.window.move({ monitor = "-1" }))
hl.bind(key("period"), hl.dsp.window.move({ monitor = "+1" }))

-- Resize windows
hl.bind(key("CTRL + left"),  hl.dsp.window.resize({ x = -40, y = 0,   relative = true }), { repeating = true })
hl.bind(key("CTRL + right"), hl.dsp.window.resize({ x = 40,  y = 0,   relative = true }), { repeating = true })
hl.bind(key("CTRL + up"),    hl.dsp.window.resize({ x = 0,   y = -40, relative = true }), { repeating = true })
hl.bind(key("CTRL + down"),  hl.dsp.window.resize({ x = 0,   y = 40,  relative = true }), { repeating = true })

-- Switch workspaces with mainMod + [0-9]
-- Move active window to a workspace with mainMod + SHIFT + [0-9]
for i = 1, 10 do
    local k = tostring(i % 10)
    hl.bind(key(k),              hl.dsp.focus({ workspace = i }))
    hl.bind(key("SHIFT + " .. k), hl.dsp.window.move({ workspace = i }))
end

-- Special workspace (scratchpad)
hl.bind(key("S"),         hl.dsp.workspace.toggle_special("magic"))
hl.bind(key("SHIFT + S"), hl.dsp.window.move({ workspace = "special:magic" }))

-- Scroll through existing workspaces
hl.bind(key("mouse_down"), hl.dsp.focus({ workspace = "e+1" }))
hl.bind(key("mouse_up"),   hl.dsp.focus({ workspace = "e-1" }))

-- Move/resize windows with mainMod + LMB/RMB
hl.bind(key("mouse:272"), hl.dsp.window.drag(),   { mouse = true })
hl.bind(key("mouse:273"), hl.dsp.window.resize(), { mouse = true })

-- Screenshots (hyprshot) - saves to ~/Pictures/Screenshots and copies to clipboard
hl.bind("CTRL + SHIFT + 3", hl.dsp.exec_cmd("hyprshot -m region -o ~/Pictures/Screenshots"))
hl.bind("CTRL + SHIFT + 4", hl.dsp.exec_cmd([[mkdir -p ~/Pictures/Screenshots && f=~/Pictures/Screenshots/$(date +%Y-%m-%d-%H%M%S)_screenshot.png && grim -o "$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')" "$f" && wl-copy < "$f"]]))

-- Media keys (also bound inside the game submap)
local function mediaBinds(full)
    hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
    hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { locked = true, repeating = true })
    hl.bind("XF86AudioMute",        hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     { locked = true, repeating = true })
    if not full then return end
    hl.bind("XF86AudioMicMute",      hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), { locked = true, repeating = true })
    hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"),                { locked = true, repeating = true })
    hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"),                { locked = true, repeating = true })
    hl.bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       { locked = true })
    hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
    hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
    hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   { locked = true })
end
mediaBinds(true)

-- Hold-to-talk: press starts, release stops
local function holdBind(keys, start, stop)
    hl.bind(keys, hl.dsp.exec_cmd(start))
    hl.bind(keys, hl.dsp.exec_cmd(stop), { release = true })
end

-- Dictation (hyprwhspr): hold, speak, release -> pasted into the focused window + Enter
holdBind(key("A"), "hyprwhspr record start", "hyprwhspr record stop")
-- DOIO KB3X-01 macropad, right dial down key (F13; xkb maps it to XF86Tools, so bind by keycode)
holdBind("code:191", "hyprwhspr record start", "hyprwhspr record stop")
-- Voice to the pa agent: hold, speak, release -> today's voice chat in `tx rc`
holdBind(key("Z"), "$HOME/.local/bin/voice-pa", "hyprwhspr record stop")
-- DOIO KB3X-01 macropad, right dial right key (F14)
holdBind("code:192", "$HOME/.local/bin/voice-pa", "hyprwhspr record stop")


------------------
---- GAMEMODE ----
------------------

-- Toggle game mode: disables most keybinds
hl.bind(key("G"), hl.dsp.submap("game"))

hl.define_submap("game", function()
    -- Only essential binds in game mode
    hl.bind(key("G"), hl.dsp.submap("reset"))
    hl.bind(key("Q"), hl.dsp.window.close())
    hl.bind(key("F"), hl.dsp.window.fullscreen())
    -- Media keys still work
    mediaBinds(false)
end)


--------------------------------
---- WINDOWS AND WORKSPACES ----
--------------------------------

hl.window_rule({
    name  = "suppress-maximize-events",
    match = { class = ".*" },
    suppress_event = "maximize",
})

hl.window_rule({
    name  = "fix-xwayland-drags",
    match = { class = "^$", title = "^$", xwayland = true, float = true, fullscreen = false, pin = false },
    no_focus = true,
})

-- Start OpenDeck minimized (send to special workspace)
hl.window_rule({
    name  = "opendeck-minimized",
    match = { class = "opendeck", title = "OpenDeck" },
    workspace = "special:minimized silent",
})

-- Gaming - enable immediate mode (tearing) for better frame pacing.
-- Moonlight (game streaming client) too, for low latency.
for _, class in ipairs({
    "steam_app_.*", "steam_proton_.*", "Battle.net.exe", "Wow.exe", "WowClassic.exe",
    "com.moonlight_stream.Moonlight",
}) do
    hl.window_rule({ match = { class = class }, immediate = true })
end

-- Star Citizen + RSI Launcher: pin to gaming monitor, fullscreen the game,
-- float (don't tile) the launcher. Hyprland tiling fights SC's swapchain
-- (1712x1004 ↔ 3840x2160 thrash) and causes cursor offset under wayland-wine.
hl.window_rule({
    name  = "star-citizen",
    match = { class = "starcitizen.exe" },
    monitor = "DP-6", fullscreen = true, immediate = true,
})
hl.window_rule({
    name  = "rsi-launcher",
    match = { class = "rsi launcher.exe" },
    monitor = "DP-6", float = true,
})

-- Stellaris (Steam App 281990): same tiling-vs-fullscreen fight as SC.
-- float prevents Hyprland tiling from constraining the resolution envelope;
-- monitor pins it to the 4K display so the game sees the right resolution list.
hl.window_rule({
    name  = "stellaris",
    match = { class = "steam_app_281990" },
    monitor = "DP-6", float = true,
})


