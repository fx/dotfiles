{{ if .is_desktop -}}
# Font
font-family = Hack Nerd Font
font-size = 11

# Minimal monochrome theme
background = #0a0a0a
foreground = #c8c8c8

# No titlebar
gtk-titlebar = false

# Padding
window-padding-x = 8
window-padding-y = 8

# Fullscreen is alt+f in Hyprland; let ctrl+enter reach the app
keybind = ctrl+enter=unbind
{{ end -}}
