{{ if .is_desktop -}}
#!/bin/bash
# Launch Battle.net via Proton without Steam
# Managed by github.com/fx/dotfiles
#
# Usage:
#   battlenet              # Launch Battle.net
#   battlenet wow          # Launch WoW directly
#   battlenet d4           # Launch Diablo 4 directly
#   battlenet --help       # Show help

set -e

# Battle.net product codes for --exec argument
# Format: [alias]="product_code"
declare -A GAME_PRODUCTS=(
    [wow]="WoW"
    [retail]="WoW"
    [classic]="WoWC"
    [wowc]="WoWC"
    [era]="WoWClassicEra"
    [anniversary]="WoWCA"
    [anni]="WoWCA"
    [forever]="WoWF"
    [wowf]="WoWF"
    [beta]="wow_beta"
    [d4]="OSI"
    [diablo4]="OSI"
    [diablo]="OSI"
    [d3]="D3"
    [diablo3]="D3"
)

# How long to wait for Battle.net to be ready (seconds)
BNET_STARTUP_WAIT=15

# Proton build to use. Either a compat tool name (proton_experimental, proton_10,
# GE-Proton9-27, ...) or an absolute path to a Proton directory.
# Overrides whatever Steam has configured for the Battle.net prefix.
BATTLENET_PROTON="${BATTLENET_PROTON:-proton_experimental}"

# Container runtime: "sniper" (Steam Linux Runtime) or "none" (host libraries).
# Proton Experimental (Wine 11) builds a GnuTLS priority string containing
# %NO_SHUFFLE_EXTENSIONS, which needs GnuTLS >= 3.8.4. Sniper ships 3.7.1, so
# every TLS handshake fails with SEC_E_INTERNAL_ERROR and Battle.net hangs at
# the login screen. Running on host libraries avoids it.
BATTLENET_RUNTIME="${BATTLENET_RUNTIME:-none}"

# Check if Battle.net is running
is_battlenet_running() {
    # Use [B] trick to prevent pgrep from matching itself
    pgrep -f "[B]attle.net.exe" &>/dev/null
}

show_help() {
    cat << 'EOF'
Battle.net Launcher (Proton)

Usage:
    battlenet [game]

Games:
    wow, retail     World of Warcraft (Retail)
    classic, wowc   World of Warcraft Classic
    era             World of Warcraft Classic Era
    anniversary     World of Warcraft Classic Anniversary
    forever         World of Warcraft Classic Beta (Forever)
    beta            World of Warcraft Retail Beta
    d4, diablo4     Diablo 4
    d3, diablo3     Diablo 3

Options:
    --help          Show this help
    --debug         Show debug information

Without arguments, launches Battle.net launcher.
With a game argument, launches Battle.net with --exec to start the game.
EOF
}

# Steam library locations to search
STEAM_PATHS=(
    "$HOME/.local/share/Steam"
    "$HOME/.steam/steam"
    "/mnt/d/SteamLibrary"
)

# Find Steam root by checking libraryfolders.vdf
find_steam_root() {
    for path in "${STEAM_PATHS[@]}"; do
        if [[ -f "$path/config/libraryfolders.vdf" ]]; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# Parse libraryfolders.vdf to get all library paths
get_library_paths() {
    local steam_root="$1"
    local vdf="$steam_root/config/libraryfolders.vdf"

    # Extract paths from VDF
    grep '"path"' "$vdf" | sed 's/.*"\([^"]*\)"/\1/' | while read -r path; do
        echo "$path"
    done
}

# Find Battle.net prefix (compatdata directory with Battle.net.exe)
find_battlenet_prefix() {
    local steam_root="$1"

    # Search in all library paths
    while IFS= read -r lib_path; do
        local compatdata="$lib_path/steamapps/compatdata"
        if [[ -d "$compatdata" ]]; then
            for prefix_dir in "$compatdata"/*/; do
                local bnet_exe="$prefix_dir/pfx/drive_c/Program Files (x86)/Battle.net/Battle.net.exe"
                if [[ -f "$bnet_exe" ]]; then
                    echo "$prefix_dir"
                    return 0
                fi
            done
        fi
    done < <(get_library_paths "$steam_root")

    return 1
}

# Get Steam's configured Proton for an app
get_steam_compat_tool() {
    local steam_root="$1"
    local app_id="$2"
    local config_vdf="$steam_root/config/config.vdf"

    if [[ -f "$config_vdf" ]]; then
        # Extract the compat tool name for this app ID
        # Looks for pattern: "APP_ID" { ... "name" "proton_xxx" ... }
        awk -v app="$app_id" '
            $0 ~ "\"" app "\"" { found=1 }
            found && /"name"/ { gsub(/"/, "", $2); print $2; exit }
            found && /^\s*\}/ { found=0 }
        ' "$config_vdf"
    fi
}

# Map Steam's compat tool name to actual path
resolve_proton_path() {
    local steam_root="$1"
    local tool_name="$2"

    # Check compatibilitytools.d first (for GE-Proton, etc.)
    local compat_dirs=(
        "$steam_root/compatibilitytools.d"
        "$HOME/.steam/root/compatibilitytools.d"
    )
    for compat_dir in "${compat_dirs[@]}"; do
        if [[ -d "$compat_dir/$tool_name" && -f "$compat_dir/$tool_name/proton" ]]; then
            echo "$compat_dir/$tool_name"
            return 0
        fi
    done

    # Map known Steam tool names to paths
    case "$tool_name" in
        proton_experimental)
            while IFS= read -r lib_path; do
                local path="$lib_path/steamapps/common/Proton - Experimental"
                if [[ -f "$path/proton" ]]; then
                    echo "$path"
                    return 0
                fi
            done < <(get_library_paths "$steam_root")
            ;;
        proton_9|proton_10)
            local version="${tool_name#proton_}"
            while IFS= read -r lib_path; do
                local path="$lib_path/steamapps/common/Proton ${version}.0"
                if [[ -f "$path/proton" ]]; then
                    echo "$path"
                    return 0
                fi
            done < <(get_library_paths "$steam_root")
            ;;
    esac

    return 1
}

# Find Proton installation (BATTLENET_PROTON, else Steam's config for this app)
find_proton() {
    local steam_root="$1"
    local app_id="$2"
    local proton_path=""

    if [[ -n "$BATTLENET_PROTON" ]]; then
        if [[ "$BATTLENET_PROTON" == /* && -f "$BATTLENET_PROTON/proton" ]]; then
            echo "${BATTLENET_PROTON%/}"
            return 0
        fi
        proton_path=$(resolve_proton_path "$steam_root" "$BATTLENET_PROTON")
        if [[ -n "$proton_path" ]]; then
            echo "$proton_path"
            return 0
        fi
        echo "Warning: BATTLENET_PROTON='$BATTLENET_PROTON' not found, falling back" >&2
        proton_path=""
    fi

    # Next, try to use Steam's configured compat tool for this app
    local tool_name
    tool_name=$(get_steam_compat_tool "$steam_root" "$app_id")
    if [[ -n "$tool_name" ]]; then
        proton_path=$(resolve_proton_path "$steam_root" "$tool_name")
        if [[ -n "$proton_path" ]]; then
            echo "$proton_path"
            return 0
        fi
    fi

    # Fallback: any tool dropped into compatibilitytools.d (GE-Proton et al).
    # Steam only records a compat tool in config.vdf once it has managed the
    # app itself, so a prefix created by battlenet-install lands here.
    local compat_dir
    for compat_dir in "$steam_root/compatibilitytools.d" "$HOME/.steam/root/compatibilitytools.d"; do
        [[ -d "$compat_dir" ]] || continue
        for tool_dir in $(ls -1dv "$compat_dir"/*/ 2>/dev/null | tac); do
            if [[ -f "${tool_dir}proton" ]]; then
                echo "${tool_dir%/}"
                return 0
            fi
        done
    done

    # Fallback: search for any Proton
    while IFS= read -r lib_path; do
        local common="$lib_path/steamapps/common"
        if [[ -f "$common/Proton - Experimental/proton" ]]; then
            echo "$common/Proton - Experimental"
            return 0
        fi
        for proton_dir in "$common"/Proton\ [0-9]*/; do
            if [[ -f "${proton_dir}proton" ]]; then
                proton_path="$proton_dir"
            fi
        done
    done < <(get_library_paths "$steam_root")

    if [[ -n "$proton_path" ]]; then
        echo "${proton_path%/}"
        return 0
    fi

    return 1
}

# Main
DEBUG=0
GAME=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            show_help
            exit 0
            ;;
        --debug)
            DEBUG=1
            shift
            ;;
        *)
            GAME="${1,,}"  # lowercase
            shift
            ;;
    esac
done

# Find paths
STEAM_ROOT=$(find_steam_root) || {
    echo "Error: Could not find Steam installation"
    echo "Run 'battlenet-install' to set up Steam, Proton and Battle.net"
    exit 1
}

BNET_PREFIX=$(find_battlenet_prefix "$STEAM_ROOT") || {
    echo "Error: Could not find Battle.net installation"
    echo "Run 'battlenet-install', or install Battle.net as a non-Steam game"
    exit 1
}

# Get app ID from prefix directory (needed for Proton lookup)
APP_ID=$(basename "$BNET_PREFIX")

PROTON_PATH=$(find_proton "$STEAM_ROOT" "$APP_ID") || {
    echo "Error: Could not find Proton installation"
    echo "Run 'battlenet-install' to install GE-Proton"
    exit 1
}

BNET_EXE="$BNET_PREFIX/pfx/drive_c/Program Files (x86)/Battle.net/Battle.net.exe"

if [[ $DEBUG -eq 1 ]]; then
    echo "Steam root:    $STEAM_ROOT"
    echo "Battle.net:    $BNET_PREFIX"
    echo "Proton:        $PROTON_PATH"
    echo "Executable:    $BNET_EXE"
fi

# Determine launch arguments
BNET_ARGS=()
if [[ -n "$GAME" ]]; then
    if [[ -v "GAME_PRODUCTS[$GAME]" ]]; then
        PRODUCT="${GAME_PRODUCTS[$GAME]}"
        BNET_ARGS+=("--exec=launch $PRODUCT")
        echo "Launching $GAME via Battle.net..."
    else
        echo "Unknown game: $GAME"
        echo "Run 'battlenet --help' for available games"
        exit 1
    fi
else
    echo "Launching Battle.net..."
fi

# Is a single value set under a single key in the prefix's user.reg?
# Scoping matters: a file-wide grep for a value matches unrelated keys.
# ENVIRON is used rather than -v because awk's -v eats the doubled backslashes
# that user.reg uses in key paths.
prefix_reg_value_is() {  # key name value
    RK="[$1]" RN="\"$2\"=$3" awk '
        index($0,"[")==1 { inkey = (index($0,ENVIRON["RK"])==1) }
        inkey && $0==ENVIRON["RN"] { ok=1 }
        END { exit(ok?0:1) }
    ' "$BNET_PREFIX/pfx/user.reg"
}

# Ensure Wine reports as Windows 11 (WoW requires 11+, Proton defaults to win7).
# The version apps see via GetVersionEx comes from HKCU\Software\Wine\Version,
# NOT the cosmetic HKLM\..\CurrentVersion keys.
#
# Both halves must be scoped to the bare [Software\\Wine] key. GE-Proton ships
# AppDefaults entries for unrelated games that already say win11, so a file-wide
# grep matches one of those and skips the patch; and the bare key does not exist
# in a fresh prefix, so an in-place edit has nothing to substitute. reg.exe
# creates it.
ensure_win11_prefix() {
    [[ -f "$BNET_PREFIX/pfx/user.reg" ]] || return
    if prefix_reg_value_is 'Software\\Wine' Version '"win11"'; then
        return
    fi
    echo "Patching Wine prefix to report Windows 11..."
    "$PROTON_PATH/proton" run reg.exe add 'HKCU\Software\Wine' \
        /v Version /t REG_SZ /d win11 /f >/dev/null 2>&1
}

# Set up Proton environment
export STEAM_COMPAT_DATA_PATH="$BNET_PREFIX"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT"
export SteamAppId="${APP_ID}"
export SteamGameId="${APP_ID}"
export STEAM_COMPAT_APP_ID="${APP_ID}"

# RTX 4000+ performance fix
export PROTON_NVIDIA_LIBS_NO_32BIT=1

# Prevent freeze when losing focus / switching workspaces
export DXVK_ASYNC=1
export VKD3D_DISABLE_EXTENSIONS=VK_KHR_present_wait

# WoW: Forever build 1.60.1.69913 ships a compute shader whose traversal loops
# have no iteration bound; on bad node data it never returns and the GPU dies
# with Xid 109 CTX SWITCH TIMEOUT on world entry. The directory holds SPIR-V
# with an iteration cap added, keyed by shader hash, so it only affects the
# shaders it was built from. Regenerate with vkd3d-cap-shader-loops after a
# client patch. See docs/games/wow-forever.md.
WOW_SHADER_OVERRIDE="$HOME/.local/share/vkd3d-shader-override/wow-forever"
if [[ -d "$WOW_SHADER_OVERRIDE" ]]; then
    export VKD3D_SHADER_OVERRIDE="$WOW_SHADER_OVERRIDE"
fi

# Find Steam Linux Runtime (sniper) for library compatibility
SNIPER_PATH=""
if [[ "$BATTLENET_RUNTIME" != "none" ]]; then
    while IFS= read -r lib_path; do
        if [[ -d "$lib_path/steamapps/common/SteamLinuxRuntime_sniper" ]]; then
            SNIPER_PATH="$lib_path/steamapps/common/SteamLinuxRuntime_sniper"
            break
        fi
    done < <(get_library_paths "$STEAM_ROOT")
fi

# Additional paths Proton expects
export STEAM_COMPAT_LIBRARY_PATHS="$STEAM_ROOT"
export STEAM_COMPAT_INSTALL_PATH="$BNET_PREFIX"

# Battle.net offers its embedded browser (CEF) the renderers "d3d11,warp,desktop"
# and picks the hardware one first. Under Proton that surface comes up black —
# the login form is laid out and the page loads fine (statusCode=200), you just
# cannot see any of it. Forcing software rendering makes it visible.
#
# The client rewrites this file when it exits, so re-assert the setting before
# every launch rather than once at install time. Skipped while the client is
# running, since it would clobber the file on exit anyway.
ensure_browser_config() {
    local cfg="$BNET_PREFIX/pfx/drive_c/users/steamuser/AppData/Roaming/Battle.net/Battle.net.config"
    [[ -f "$cfg" ]] || return
    is_battlenet_running && return
    if ! command -v jq >/dev/null 2>&1; then
        echo "Warning: jq not found, cannot check browser hardware acceleration"
        return
    fi
    [[ "$(jq -r '.Client.HardwareAcceleration // empty' "$cfg" 2>/dev/null)" == "false" ]] && return
    echo "Disabling Battle.net browser hardware acceleration (black login page fix)..."
    if jq '.Client.HardwareAcceleration = "false"' "$cfg" > "$cfg.tmp" 2>/dev/null; then
        mv "$cfg.tmp" "$cfg"
    else
        rm -f "$cfg.tmp"
        echo "Warning: could not update $(basename "$cfg")"
    fi
}

# Needs the compat env above, so it runs here rather than at parse time.
ensure_win11_prefix
ensure_browser_config

# Function to run Battle.net with optional arguments
run_battlenet() {
    local args=("$@")
    if [[ -n "$SNIPER_PATH" && -x "$SNIPER_PATH/run" ]]; then
        if [[ $DEBUG -eq 1 ]]; then
            echo "Runtime:       $SNIPER_PATH"
            echo "Arguments:     ${args[*]}"
            echo "Using pressure-vessel container"
        fi
        "$SNIPER_PATH/run" -- "$PROTON_PATH/proton" run "$BNET_EXE" "${args[@]}" &
    else
        if [[ $DEBUG -eq 1 ]]; then
            echo "Runtime:       host libraries (BATTLENET_RUNTIME=$BATTLENET_RUNTIME)"
            echo "Arguments:     ${args[*]}"
        fi
        "$PROTON_PATH/proton" run "$BNET_EXE" "${args[@]}" &
    fi
}

# If launching a game and Battle.net isn't running, start it first
if [[ -n "$GAME" ]] && ! is_battlenet_running; then
    echo "Starting Battle.net first..."
    run_battlenet

    # Wait for Battle.net to be ready
    echo "Waiting for Battle.net to initialize (${BNET_STARTUP_WAIT}s)..."
    sleep "$BNET_STARTUP_WAIT"

    if ! is_battlenet_running; then
        echo "Error: Battle.net failed to start"
        exit 1
    fi
fi

# Launch with arguments (or just start if no game specified)
if [[ ${#BNET_ARGS[@]} -gt 0 ]]; then
    run_battlenet "${BNET_ARGS[@]}"
else
    # No game specified - just launch Battle.net if not already running
    if is_battlenet_running; then
        echo "Battle.net is already running"
    else
        run_battlenet
    fi
fi

# Wait briefly for the command to be sent
sleep 1
{{ end -}}
