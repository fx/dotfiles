#!/bin/bash
# Managed by github.com/fx/dotfiles
# Import photos/videos from a camera/phone to ~/Pictures/Photos organized by date
#
# Usage: camera-import [--dry-run]
#
# It picks the fastest available transport, copying only files missing from the
# destination — existing ones are skipped with an instant local stat rather than
# re-read over USB, so a mostly-synced library imports in seconds plus the
# transfer time of genuinely new files:
#
#   1. Mass Storage (MSC): a camera in Mass Storage mode, or an SD card in a
#      reader, exposes its real filesystem — full card speed, no MTP overhead.
#      This is by far the fastest; prefer it for cameras that offer it (Sony).
#   2. jmtpfs: MTP devices (Android phones, MTP cameras) as a FUSE filesystem.
#      libmtp doesn't recognize some bodies (many Sony), which then fall to (3).
#   3. gphoto2: PTP/MTP cameras jmtpfs can't mount. Slowest (per-file round
#      trips) but broadest; streams per-folder progress so it never looks hung.
#
# Files are organized by their capture timestamp into:
#   ~/Pictures/Photos/YYYY/YYYY-MM-DD/<original filename>
#
# Requires: udisks2 (MSC), jmtpfs (MTP), and/or gphoto2 (PTP) — any one works.

set -euo pipefail

DEST="$HOME/Pictures/Photos"
DRY_RUN=false

for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        -h|--help)
            echo "Usage: camera-import [--dry-run]"
            echo "Import photos/videos from camera to ~/Pictures/Photos/YYYY/YYYY-MM-DD/"
            exit 0
            ;;
        *) echo "Unknown option: $arg" >&2; exit 1 ;;
    esac
done

# Copy every file under the given root dir(s) into $DEST, organized by each
# file's mtime (YYYY/YYYY-MM-DD), skipping any that already exist with an
# instant local stat. Shared by the MSC and jmtpfs fast paths — both hand it a
# real (or FUSE) filesystem, so skip-existing costs a local stat, not a device
# round-trip. Streams each copied/skipped file and prints the summary.
copy_tree() {
    local roots=("$@")
    mkdir -p "$DEST"
    local copied=0 skipped=0 failed=0 f m day base target
    while IFS= read -r -d '' f; do
        m=$(stat -c '%Y' "$f" 2>/dev/null) || { failed=$((failed+1)); continue; }
        day=$(date -d "@$m" +%Y/%Y-%m-%d)
        base=$(basename "$f")
        target="$DEST/$day/$base"
        if [[ -e "$target" ]]; then
            skipped=$((skipped+1))
            continue
        fi
        if $DRY_RUN; then
            copied=$((copied+1))
            echo "  NEW: $day/$base"
            continue
        fi
        mkdir -p "$DEST/$day"
        if cp --preserve=timestamps "$f" "$target" 2>/dev/null; then
            copied=$((copied+1))
            echo "  + $day/$base"
        else
            rm -f "$target" 2>/dev/null || true   # drop any partial copy
            failed=$((failed+1))
            echo "  FAILED: $base" >&2
        fi
    done < <(find "${roots[@]}" -type f -print0 2>/dev/null)

    echo ""
    if $DRY_RUN; then
        echo "Dry run: $copied new, $skipped already present, $failed unreadable."
        echo "Would organize into $DEST/YYYY/YYYY-MM-DD/"
    else
        echo "Import complete: $copied imported, $skipped skipped, $failed failed."
    fi
}

# ---------------------------------------------------------------------------
# Fastest path: USB Mass Storage (MSC) — the camera's SD card as a block device
# ---------------------------------------------------------------------------
# A camera in Mass Storage mode (or an SD card in a reader) exposes its real
# filesystem, so enumeration and skip-existing run at full card speed instead of
# MTP's per-file round-trips (seconds vs. minutes on slow bodies like Sony).
MSC_MOUNTED=()   # devices WE mounted (for cleanup); empty if all were already mounted
cleanup_msc() {
    [[ ${#MSC_MOUNTED[@]} -gt 0 ]] || return 0
    local d
    for d in "${MSC_MOUNTED[@]}"; do
        udisksctl unmount -b "$d" >/dev/null 2>&1 || true
    done
    MSC_MOUNTED=()
}
import_via_msc() {
    command -v lsblk >/dev/null 2>&1 || return 1

    # Only look at removable (RM=1) block partitions, so we never stat unrelated
    # network/system mounts (a DCIM lookup on an NFS share costs a round-trip).
    # An already-mounted card is used in place; an unmounted one is mounted via
    # udisks (no root), checked for a DCIM dir, and unmounted again if it isn't
    # a camera. FSTYPE/MOUNTPOINT are last so unmounted rows still parse.
    # DCIM marks a camera card, but it only holds stills — enumerate on DCIM,
    # then import from the card root. Sony writes XAVC S/HS video to
    # PRIVATE/M4ROOT/CLIP and AVCHD to PRIVATE/AVCHD/BDMV/STREAM, neither under
    # DCIM, so a DCIM-only sweep silently drops every video. Track the card root.
    # Scan EVERY removable volume, not just the first with a DCIM: a device can
    # expose more than one at a time — a DJI drone presents its internal storage
    # and the inserted SD card as two separate volumes — and stopping at the
    # first silently imports only one of them.
    # Match TYPE "disk" as well as "part": a card formatted in-camera often has
    # no partition table at all, the whole device carries the filesystem, so it
    # shows up as a disk. A *partitioned* removable disk has an empty FSTYPE and
    # no mountpoint, so it falls through here and its partitions are matched
    # instead — no double-mounting.
    local cards=() dev type rm fstype mnt out m
    trap cleanup_msc EXIT
    while read -r dev type rm fstype mnt; do
        [[ ( "$type" == "part" || "$type" == "disk" ) && "$rm" == "1" ]] || continue
        if [[ -n "$mnt" ]]; then
            [[ -d "$mnt/DCIM" ]] && cards+=("$mnt")
        elif [[ -n "$fstype" ]] && command -v udisksctl >/dev/null 2>&1; then
            out=$(udisksctl mount -b "$dev" 2>/dev/null) || continue
            m="${out##* at }"; m="${m%.}"
            if [[ -d "$m/DCIM" ]]; then
                cards+=("$m"); MSC_MOUNTED+=("$dev")
            else
                udisksctl unmount -b "$dev" >/dev/null 2>&1 || true
            fi
        fi
    done < <(lsblk -rpno NAME,TYPE,RM,FSTYPE,MOUNTPOINT 2>/dev/null)

    [[ ${#cards[@]} -gt 0 ]] || return 1

    # Stills (DCIM) plus the out-of-DCIM movie trees. copy_tree organizes by
    # mtime and skips existing files, so listing a root a given card doesn't use
    # is harmless. XAVC clips carry a small .XML sidecar in CLIP; it rides along
    # into the date folder — cheap, and useful capture metadata to keep.
    # All cards feed one copy_tree call, so duplicates across volumes collapse
    # naturally and the run reports a single combined summary.
    local roots=() card d
    for card in "${cards[@]}"; do
        echo "Camera SD card (mass storage) at $card"
        for d in DCIM PRIVATE/M4ROOT/CLIP PRIVATE/AVCHD/BDMV/STREAM MP_ROOT; do
            [[ -d "$card/$d" ]] && roots+=("$card/$d")
        done
    done

    copy_tree "${roots[@]}"
    return 0
}

# Mount point for the jmtpfs fast path. Kept at script scope (not a function
# local) so the EXIT trap can still reach it under `set -u` when it fires
# after the function has returned.
MNT=""
cleanup_mount() {
    [[ -n "${MNT:-}" ]] || return 0
    fusermount -u "$MNT" 2>/dev/null || true
    rmdir "$MNT" 2>/dev/null || true
    MNT=""
}

# ---------------------------------------------------------------------------
# Fast path: jmtpfs (FUSE MTP mount + local skip-existing) — MTP phones/cameras
# ---------------------------------------------------------------------------
import_via_jmtpfs() {
    command -v jmtpfs &>/dev/null || return 1

    MNT=$(mktemp -d "${TMPDIR:-/tmp}/camera-import.XXXXXX")
    # Mount; jmtpfs prints nothing on success. Failure means no MTP device
    # (or libmtp doesn't recognize it, e.g. many Sony bodies) — clean up and
    # let the caller fall back to gphoto2.
    if ! jmtpfs "$MNT" >/dev/null 2>&1; then
        rmdir "$MNT" 2>/dev/null || true
        MNT=""
        return 1
    fi
    # Ensure we always unmount, even on error/interrupt.
    trap cleanup_mount EXIT

    # Discover import roots. Android/MTP cameras expose one or more storages as
    # top-level dirs; real photos live under <storage>/DCIM. Sony MTP cameras
    # skip DCIM and put date folders directly under the storage, so if no DCIM
    # exists anywhere we fall back to the storage roots themselves.
    local roots=() storage
    shopt -s nullglob
    for storage in "$MNT"/*/; do
        [[ -d "${storage%/}/DCIM" ]] && roots+=("${storage%/}/DCIM")
    done
    if [[ ${#roots[@]} -eq 0 ]]; then
        for storage in "$MNT"/*/; do
            roots+=("${storage%/}")
        done
    fi
    shopt -u nullglob

    if [[ ${#roots[@]} -eq 0 ]]; then
        echo "No storage found on device." >&2
        cleanup_mount
        trap - EXIT
        return 1
    fi

    echo "Import roots:"
    printf '  %s\n' "${roots[@]#$MNT/}"
    copy_tree "${roots[@]}"
    return 0
}

# ---------------------------------------------------------------------------
# Fallback: gphoto2 (PTP cameras jmtpfs can't mount)
# ---------------------------------------------------------------------------
import_via_gphoto2() {
    command -v gphoto2 &>/dev/null || return 1

    local camera camera_name
    camera=$(gphoto2 --auto-detect 2>/dev/null | tail -n +3 | head -1)
    [[ -z "$camera" ]] && return 1

    camera_name=$(echo "$camera" | sed 's/  *usb:.*//')
    echo "Detected: $camera_name"

    local import_roots=() storages=()

    list_children() {
        local parent="$1"
        gphoto2 --list-folders --folder "$parent" 2>/dev/null | awk -v parent="$parent" '
            /^There (is|are) [0-9]+ folder/ {
                if (seen) exit
                match($0, /'"'"'[^'"'"']+'"'"'/)
                current = substr($0, RSTART+1, RLENGTH-2)
                if (current == parent) { seen = 1; next }
                exit
            }
            seen && /^ - / { sub(/^ - /, ""); print }
        '
    }
    probe() {
        gphoto2 --list-files --folder "$1" >/dev/null 2>&1 && import_roots+=("$1")
    }

    probe "/DCIM"
    if [[ ${#import_roots[@]} -eq 0 ]]; then
        mapfile -t storages < <(list_children /)
        for storage in "${storages[@]}"; do
            [[ -z "$storage" ]] && continue
            probe "/$storage/DCIM"
        done
    fi
    if [[ ${#import_roots[@]} -eq 0 ]]; then
        for storage in "${storages[@]}"; do
            [[ -z "$storage" ]] && continue
            probe "/$storage"
        done
    fi
    [[ ${#import_roots[@]} -eq 0 ]] && return 1

    echo "Import roots: ${import_roots[*]}"

    if $DRY_RUN; then
        echo ""
        for folder in "${import_roots[@]}"; do
            echo "Files under $folder:"
            gphoto2 --list-files -R --folder "$folder" 2>/dev/null | grep "^#" | while read -r line; do
                echo "  $(echo "$line" | awk '{print $2}') ($(echo "$line" | awk '{print $4}') KB)"
            done
        done
        echo ""
        echo "Would be organized into $DEST/YYYY/YYYY-MM-DD/"
        return 0
    fi

    mkdir -p "$DEST"
    echo "Using the gphoto2 path (slower MTP transfer, and this camera isn't"
    echo "mountable via jmtpfs). Some bodies — notably Sony — take ~20s per"
    echo "folder just to list files, so expect a pause before each folder's"
    echo "transfers begin. For a large backlog, a card reader is far faster."
    local log
    log=$(mktemp)
    trap 'rm -f "$log"' EXIT

    # Scan one folder, streaming each Saving/Skipping line live so the slow
    # gphoto2 path never looks hung. $2 is "" (this folder only) or "-R"
    # (recurse into its subfolders).
    scan_folder() {
        local folder="$1" recurse="$2"
        echo "Scanning $folder ..."
        # shellcheck disable=SC2086
        stdbuf -oL gphoto2 --get-all-files $recurse --folder "$folder" --skip-existing \
            --filename "$DEST/%Y/%Y-%m-%d/%f.%C" 2>&1 \
            | stdbuf -oL grep -E "^(Saving|Skipping) " \
            | tee -a "$log" \
            | sed 's/^/  /' || true
    }

    # Break each root into per-folder passes for visible progress: the root
    # itself non-recursively (any loose files) then each immediate subfolder
    # recursively (Sony's date folders, or DCIM/<subdir> on cameras that nest).
    local root child children=()
    for root in "${import_roots[@]}"; do
        scan_folder "$root" ""
        mapfile -t children < <(list_children "$root")
        for child in "${children[@]}"; do
            [[ -z "$child" ]] && continue
            scan_folder "$root/$child" "-R"
        done
    done
    local imported skipped
    imported=$(grep -c "^Saving " "$log" || true)
    skipped=$(grep -c "^Skipping " "$log" || true)
    echo ""
    echo "Import complete: $imported imported, $skipped skipped."
    return 0
}

echo "Looking for a connected camera or phone..."
# Fastest first: SD card as mass storage, then MTP via jmtpfs, then PTP gphoto2.
if import_via_msc; then
    exit 0
fi
if import_via_jmtpfs; then
    exit 0
fi
if import_via_gphoto2; then
    exit 0
fi

echo "Error: No camera/phone/card found. Connect the device and either:" >&2
echo "  - set the camera's USB mode to Mass Storage (fastest), or" >&2
echo "  - unlock the phone and set USB mode to file transfer (MTP)." >&2
echo "Requires udisks2 (mass storage), jmtpfs (MTP), or gphoto2 (PTP)." >&2
exit 1
