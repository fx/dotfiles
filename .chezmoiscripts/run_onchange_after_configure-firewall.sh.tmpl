#!/bin/bash
# Configure UFW firewall rules for desktop services
# Only runs on desktop profile
# Hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

{{ if .is_desktop -}}
set -e

if ! command -v ufw &> /dev/null; then
    echo "ufw not installed, skipping firewall configuration"
    exit 0
fi

# Ensure UFW is enabled
if ! sudo ufw status | grep -q "Status: active"; then
    echo "UFW is not active, skipping firewall configuration"
    exit 0
fi

echo "Firewall configuration check passed"

# SSH, reachable over Tailscale only — deliberately NOT opened to the LAN,
# since PasswordAuthentication is still enabled on this host.
# The `on tailscale0` rule also covers the tailnet's IPv6 ULA; the CGNAT rule
# is the v4 fallback for when traffic arrives before the interface match.
if ! sudo ufw status | grep -q "^22/tcp on tailscale0"; then
    sudo ufw allow in on tailscale0 to any port 22 proto tcp comment "SSH via Tailscale"
fi

if ! sudo ufw status | grep -qE "^22/tcp +ALLOW IN +100\.64\.0\.0/10"; then
    sudo ufw allow from 100.64.0.0/10 to any port 22 proto tcp comment "SSH via Tailscale CGNAT"
fi

# Add further firewall rules here as needed
# Example:
# if ! sudo ufw status | grep -q "8080/tcp"; then
#     sudo ufw allow 8080/tcp comment "HTTP alt"
# fi

{{ else -}}
# Not a desktop profile, skip firewall configuration
{{ end -}}
